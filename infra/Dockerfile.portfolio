# syntax=docker/dockerfile:1
FROM node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS portfolio
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci
COPY . .
ENV VITE_PORTFOLIO_DEMO=true
RUN npm run build
RUN mkdir -p /data && chown node:node /data
USER node
ENV NODE_ENV=production DATA_MODE=synthetic CLINIC_TIME_ZONE=Asia/Almaty DATABASE_POOL_SIZE=5
EXPOSE 8080
CMD ["node", "infra/portfolio/entry.mjs"]
