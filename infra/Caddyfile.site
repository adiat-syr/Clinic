(site) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    X-Frame-Options DENY
    -Server
    X-Robots-Tag {$ROBOTS_POLICY:noindex}
  }
  encode zstd gzip
  @public path / /ru /ru/* /kk /kk/*
  handle @public {
    reverse_proxy api:3001 {
      header_up X-Forwarded-For {remote_host}
      header_up -Forwarded
      transport http {
        response_header_timeout 15s
      }
    }
  }
  handle /api/* {
    reverse_proxy api:3001 {
      header_up X-Forwarded-For {remote_host}
      header_up -Forwarded
      transport http {
        response_header_timeout 15s
      }
    }
  }
  handle {
    root * /srv
    @hashed path /assets/*
    header @hashed Cache-Control "public, max-age=31536000, immutable"
    @private path /admin* /ru/phone-consent /kk/phone-consent
    header @private Cache-Control "no-store"
    @staff path /admin /admin/*
    rewrite @staff /prerender-template.html
    try_files {path} {path}/index.html =404
    file_server
  }
  handle_errors {
    root * /srv
    rewrite * /404.html
    file_server
  }
}
