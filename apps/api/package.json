{
  "name": "@clinic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=../../.env --import tsx src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.check.json --noEmit",
    "db:generate": "prisma generate",
    "staff:bootstrap": "node --env-file=../../.env --import tsx scripts/staff.ts bootstrap",
    "staff:credentials": "node --env-file=../../.env --import tsx scripts/staff.ts credentials",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && prisma db seed",
    "db:validate": "prisma validate",
    "db:check": "node --env-file=../../.env --import tsx scripts/check-database.ts",
    "consent:publish": "node --env-file=../../.env --import tsx scripts/consent.ts",
    "staff:recover-admin": "node --env-file=../../.env --import tsx scripts/staff.ts recover-admin",
    "staff:email": "node --env-file=../../.env --import tsx scripts/staff.ts change-email"
  },
  "dependencies": {
    "@clinic/contracts": "0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
