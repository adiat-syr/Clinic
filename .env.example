# Local synthetic development only. npm run setup replaces the password placeholder.
NODE_ENV=development
DATA_MODE=synthetic
API_HOST=127.0.0.1
API_PORT=3001
CLINIC_TIME_ZONE=Asia/Almaty
POSTGRES_USER=clinic_local
POSTGRES_DB=clinic_local
POSTGRES_PORT=55432
POSTGRES_PASSWORD=replace-me-local-only
DATABASE_URL=postgresql://clinic_local:replace-me-local-only@127.0.0.1:55432/clinic_local
# Private server keys; never use VITE_ prefixes or commit a filled .env.
AUTH_ORIGIN=http://127.0.0.1:5173
AUTH_MFA_KEY=replace-with-mfa-key
AUTH_CSRF_KEY=replace-with-csrf-key

# Generated locally by npm run setup; never use VITE_* or commit their values:
# CONTACT_KEY_VERSION=local-v1
# CONTACT_KEYS_JSON={"local-v1":"<64 lowercase hex characters>"}
# BOOKING_HMAC_KEY=<independent 64 lowercase hex characters>

# Optional development controls (production: infra/prepare.mjs + private *_FILE mounts):
# DATABASE_POOL_SIZE=20
# CLINIC_PROFILE_FILE=<bilingual JSON profile; see infra/clinic.demo.json>
# AUTH_MFA_KEYS_JSON={"v2":"<independent 64 hex characters>"}
# AUTH_MFA_ACTIVE_VERSION=v2
# DATA_MODE=clinic additionally requires explicit CLINIC_ACTIVATION_FILE.
# See docs/DEPLOYMENT.md. Never add VITE_ secrets or real patient data in development.
