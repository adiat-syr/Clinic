{
  "name": "clinic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "npm run build --workspace @clinic/contracts && npm run db:generate",
    "dev": "concurrently --kill-others --names contracts,api,web \"npm:dev:contracts\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:contracts": "npm run dev --workspace @clinic/contracts",
    "dev:api": "npm run dev --workspace @clinic/api",
    "dev:web": "npm run dev --workspace @clinic/web",
    "build": "npm run build --workspace @clinic/contracts && npm run build --workspace @clinic/api && npm run build --workspace @clinic/web",
    "typecheck": "npm run build --workspace @clinic/contracts && npm run typecheck --workspaces && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build --workspace @clinic/contracts && vitest run",
    "test:integration": "npm run db:generate && node --env-file-if-exists=.env --import tsx apps/api/scripts/test-integration.ts",
    "db:generate": "npm run db:generate --workspace @clinic/api",
    "db:deploy": "npm run db:deploy --workspace @clinic/api",
    "db:seed": "npm run db:seed --workspace @clinic/api",
    "db:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "db:validate": "npm run db:validate --workspace @clinic/api",
    "db:check": "npm run db:check --workspace @clinic/api",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
